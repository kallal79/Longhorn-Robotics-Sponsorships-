{
  "name": "go-to-plan-gtm-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --host 127.0.0.1 --port 4173 --open",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.mjs",
    "generate:deliverables": "node scripts/generate-deliverables.mjs",
    "qa:e2e": "node scripts/qa-live-browser.mjs",
    "verify:all": "npm run test && npm run build && npm run generate:deliverables"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
